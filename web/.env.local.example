# Local-only env for `npm run dev` — copy to `web/.env.local` and fill in.
# `.env.local` is gitignored; never commit real values or the project id.
#
#   cp web/.env.local.example web/.env.local
#
# 1. IDENTITY_PLATFORM_API_KEY — the server-held Identity Toolkit key.
#    Get it from Terraform state (after `terraform apply` of infra/app.tf):
#      terraform -chdir=infra output -raw identity_platform_api_key
#    It is restricted to identitytoolkit.googleapis.com and is server-only
#    (AD-004) — the app never ships it to the browser.
IDENTITY_PLATFORM_API_KEY=

# 2. GOOGLE_CLOUD_PROJECT — your GCP project id. firebase-admin reads it to mint
#    and verify session cookies via Application Default Credentials. Same value
#    as `project_id` in infra/terraform.tfvars.
GOOGLE_CLOUD_PROJECT=

# firebase-admin also needs Application Default Credentials on your machine:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <project-id>
