# Local-only env for `npm run dev` — copy to `web/.env.local` and fill in.
# `.env.local` is gitignored; never commit real values or the project id.
#
#   cp web/.env.local.example web/.env.local
#
# 1. GOOGLE_CLOUD_PROJECT — your GCP project id. Same value as `project_id` in
#    infra/terraform.tfvars. Used for two things:
#      - firebase-admin ADC project (mint/verify session cookies);
#      - which project's Secret Manager holds the Identity Platform API key.
GOOGLE_CLOUD_PROJECT=

# 2. IDENTITY_PLATFORM_API_KEY — OPTIONAL locally. If unset, the app reads the
#    key from Secret Manager (secret `identity-platform-api-key`) using your ADC,
#    which is the production path. Set it to skip that round-trip / work offline:
#      terraform -chdir=infra output -raw identity_platform_api_key
#    Server-only either way (AD-004) — never shipped to the browser.
IDENTITY_PLATFORM_API_KEY=

# Application Default Credentials are needed on your machine for BOTH the
# firebase-admin cookie path and the Secret Manager read:
#   gcloud auth application-default login
#   gcloud auth application-default set-quota-project <project-id>
