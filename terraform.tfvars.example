# Copy this file to terraform.tfvars (gitignored) and fill in real values.
# Used by infra/ (main root) unless noted otherwise.

project_id            = "my-gcp-project-id"     # existing GCP project ID
region                = "us-east1"              # Always Free eligible region
zone                  = "us-east1-b"            # Always Free eligible zone
ssh_username          = "ubuntu"                # OS login user injected via metadata
ssh_public_key_path   = "~/.ssh/id_ed25519.pub" # path to your existing SSH public key
operator_ssh_cidrs    = []                       # e.g. ["203.0.113.4/32"]; empty = IAP-only SSH

# infra/bootstrap/ only:
billing_account_name        = "My Billing Account" # from `gcloud billing accounts list`
billing_alert_currency_code = "USD"                 # budget currency
billing_alert_amount        = "5"                   # budget tripwire, whole units
state_bucket_name           = "my-project-tfstate"  # must be globally unique
